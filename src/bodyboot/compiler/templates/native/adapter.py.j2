    def velocity(self, vx: float, vy: float, yaw_rate: float) -> MockMotionCommand:
        """MOCK-ONLY body velocity setpoint (vx fwd m/s, vy left m/s, yaw_rate CCW rad/s).

        Translates to the vendor convention, clamps to documented vendor limits and
        records the would-be vendor call. The vendor SDK is never invoked.
        """
{% if not motion %}
        raise CapabilityUnavailableError({{ motion_unavailable_reason | py }})
{% else %}
        if self._session is None:
            raise NotConnectedError("call connect() first")
        canonical = {
            "vx": require_finite("vx", vx),
            "vy": require_finite("vy", vy),
            "yaw_rate": require_finite("yaw_rate", yaw_rate),
        }
        vendor_kwargs: dict[str, float] = {}
        clamped = False
        for vendor_param, source, scale, constant, low, high in MOTION_PARAMETERS:
            raw = canonical[source] * scale if source is not None else float(constant or 0.0)
            limited = clamp(raw, low, high)
            clamped = clamped or limited != raw
            vendor_kwargs[vendor_param] = limited
        command = MockMotionCommand(
            vendor_symbol=MOTION_VENDOR_SYMBOL,
            vendor_kwargs=vendor_kwargs,
            canonical=canonical,
            clamped=clamped,
            forwarded_to_vendor=False,
        )
        self.command_log.append(command)
        return command
