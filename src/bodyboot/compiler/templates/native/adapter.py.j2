def _attr(obj: Any, dotted: str) -> Any:
    for segment in dotted.split("."):
        obj = getattr(obj, segment)
    return obj


def _scalar(record: Any, path: str, index: int | None, scale: float) -> float:
    value = _attr(record, path)
    if index is not None:
        value = value[index]
    return float(value) * scale


def _vector(
    record: Any, paths: list[str], indices: list[int] | None, scale: float, size: int
) -> tuple[float, ...]:
    if len(paths) == 1:
        sequence = _attr(record, paths[0])
        picks = indices if indices is not None else list(range(size))
        return tuple(float(sequence[i]) * scale for i in picks)
    return tuple(float(_attr(record, path)) * scale for path in paths)


