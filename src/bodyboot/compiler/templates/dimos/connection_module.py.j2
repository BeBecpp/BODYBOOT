"""GENERATED by BODYBOOT {{ generator_version }} (run {{ run_id }}) - dimOS connection Module.

Wraps the generated canonical adapter as a dimOS Module with typed streams,
following the conventions of dimos/robot/unitree/go2/connection.py.

SAFETY: ``cmd_vel`` is accepted but handled MOCK-ONLY. Twists are translated and
logged; nothing is forwarded to the vendor SDK. Real motion is disabled in
BODYBOOT milestone 1 and this module has NOT been validated on hardware.
"""

from __future__ import annotations

import threading
import time
from typing import Any

import numpy as np
from reactivex.disposable import Disposable

from dimos.core.core import rpc
from dimos.core.module import Module, ModuleConfig
from dimos.core.stream import In, Out
from dimos.msgs.geometry_msgs.PoseStamped import PoseStamped
from dimos.msgs.geometry_msgs.Quaternion import Quaternion
from dimos.msgs.geometry_msgs.Twist import Twist
from dimos.msgs.geometry_msgs.Vector3 import Vector3
from dimos.msgs.sensor_msgs.Image import Image, ImageFormat
from dimos.msgs.sensor_msgs.Imu import Imu

from .native import GeneratedRobotAdapter, MockMotionCommand

REAL_MOTION_ENABLED = False


class BodybootConnectionConfig(ModuleConfig):
    poll_hz: float = 10.0
    camera: bool = True
    odom_frame_id: str = {{ odom_frame | py }}
    imu_frame_id: str = {{ imu_frame | py }}
    camera_frame_id: str = {{ camera_frame | py }}


class BodybootConnection(Module):
    """Connection to the ``{{ plan.sdk_package }}`` robot through the BODYBOOT-generated adapter."""

    config: BodybootConnectionConfig

    cmd_vel: In[Twist]
    color_image: Out[Image]
    odom: Out[PoseStamped]
    imu: Out[Imu]

    def __init__(self, **kwargs: Any) -> None:
        super().__init__(**kwargs)
        self._adapter: GeneratedRobotAdapter | None = None
        self._thread: threading.Thread | None = None
        self._running = threading.Event()
        self._last_mock: MockMotionCommand | None = None

    @rpc
    def start(self) -> None:
        super().start()
        self._adapter = GeneratedRobotAdapter()
        self._adapter.connect()
        self.register_disposable(Disposable(self.cmd_vel.subscribe(self._on_cmd_vel)))
        self._running.set()
        self._thread = threading.Thread(target=self._poll, name="bodyboot-poll", daemon=True)
        self._thread.start()

    @rpc
    def stop(self) -> None:
        self._running.clear()
        if self._thread is not None:
            self._thread.join(timeout=2.0)
            self._thread = None
        if self._adapter is not None:
{% if stop %}
            self._adapter.stop()
{% endif %}
            self._adapter.close()
            self._adapter = None
        super().stop()

    def _poll(self) -> None:
        period = 1.0 / max(self.config.poll_hz, 0.1)
        while self._running.is_set():
            adapter = self._adapter
            if adapter is None:
                return
{% if has.odometry %}
            odom = adapter.odometry()
            half = odom.yaw_rad / 2.0
            self.odom.publish(
                PoseStamped(
                    ts=time.time(),
                    frame_id=self.config.odom_frame_id,
                    position=odom.position_m,
                    orientation=(0.0, 0.0, float(np.sin(half)), float(np.cos(half))),
                )
            )
{% endif %}
{% if has.imu %}
            sample = adapter.imu()
            self.imu.publish(
                Imu(
                    angular_velocity=Vector3(*sample.gyro_rps),
                    linear_acceleration=Vector3(*sample.accel_mps2),
                    orientation=Quaternion(*sample.orientation_xyzw),
                    frame_id=self.config.imu_frame_id,
                    ts=time.time(),
                )
            )
{% endif %}
{% if has.camera %}
            if self.config.camera:
                frame = adapter.camera_rgb()
                pixels = np.frombuffer(frame.data, dtype=np.uint8).reshape(frame.height, frame.width, 3)
                self.color_image.publish(
                    Image.from_numpy(
                        pixels, format=ImageFormat.RGB, frame_id=self.config.camera_frame_id
                    )
                )
{% endif %}
            time.sleep(period)

    def _on_cmd_vel(self, twist: Twist) -> None:
        self.move(twist)

    @rpc
    def move(self, twist: Twist, duration: float = 0.0) -> bool:
        """MOCK-ONLY: translate and log the twist. Nothing reaches the robot. Returns False."""
        if self._adapter is None:
            return False
{% if motion %}
        self._last_mock = self._adapter.velocity(
            float(twist.linear.x), float(twist.linear.y), float(twist.angular.z)
        )
{% endif %}
        return False

    @rpc
    def stop_movement(self) -> None:
        """Halt locomotion (zero motion)."""
{% if stop %}
        if self._adapter is not None:
            self._adapter.stop()
{% else %}
        return None
{% endif %}

    @rpc
    def health(self) -> dict[str, Any]:
        """Link health as a plain dict: alive, latency_s, real_motion_enabled."""
        if self._adapter is None:
            return {"alive": False, "latency_s": None, "real_motion_enabled": REAL_MOTION_ENABLED}
{% if has.health %}
        sample = self._adapter.health()
        return {
            "alive": sample.alive,
            "latency_s": sample.latency_s,
            "real_motion_enabled": REAL_MOTION_ENABLED,
        }
{% else %}
        return {"alive": True, "latency_s": None, "real_motion_enabled": REAL_MOTION_ENABLED}
{% endif %}

    @rpc
    def last_mock_command(self) -> dict[str, Any]:
        """The most recent would-be vendor motion call (never executed)."""
        command = self._last_mock
        if command is None:
            return {}
        return {
            "vendor_symbol": command.vendor_symbol,
            "vendor_kwargs": dict(command.vendor_kwargs),
            "clamped": command.clamped,
            "forwarded_to_vendor": command.forwarded_to_vendor,
        }
