"""GENERATED by BODYBOOT {{ generator_version }} (run {{ run_id }}) - agent-facing skills.

Every @skill has a docstring and fully typed parameters and returns ``str``,
as dimOS requires. @skill implies @rpc, so the two are never stacked.

SAFETY: ``move_velocity`` is MOCK-ONLY in BODYBOOT milestone 1.
"""

from __future__ import annotations

from dimos.agents.annotation import skill
from dimos.core.core import rpc
from dimos.core.module import Module
from dimos.msgs.geometry_msgs.Twist import Twist
from dimos.msgs.geometry_msgs.Vector3 import Vector3

from .connection_spec import BodybootConnectionSpec

EMBODIMENT_SUMMARY = {{ summary | py }}


class BodybootSkillContainer(Module):
    """High-level skills over the BODYBOOT-generated robot connection."""

    _connection: BodybootConnectionSpec

    @rpc
    def start(self) -> None:
        super().start()

    @rpc
    def stop(self) -> None:
        super().stop()

    @skill
    def robot_health(self) -> str:
        """Report whether the link to the robot is alive and its round-trip latency."""
        status = self._connection.health()
        return (
            f"alive={status.get('alive')} latency_s={status.get('latency_s')} "
            f"real_motion_enabled={status.get('real_motion_enabled')}"
        )

    @skill
    def describe_embodiment(self) -> str:
        """Describe which robot capabilities were discovered and how they map to the vendor SDK."""
        return EMBODIMENT_SUMMARY

    @skill
    def stop_robot(self) -> str:
        """Halt all locomotion immediately. The robot stays standing. Always safe to call."""
        self._connection.stop_movement()
        return "Stop command sent."

    @skill
    def move_velocity(self, vx: float, vy: float, yaw_rate: float) -> str:
        """MOCK-ONLY velocity command. Real motion is disabled; the robot will NOT move.

        Translates the request into the vendor convention and reports the call that
        would be made, so an agent can rehearse a motion plan safely.

        Args:
            vx: Forward speed in m/s (positive = forward).
            vy: Lateral speed in m/s (positive = left).
            yaw_rate: Turn rate in rad/s (positive = counter-clockwise).
        """
        self._connection.move(Twist(Vector3(vx, vy, 0.0), Vector3(0.0, 0.0, yaw_rate)))
        mock = self._connection.last_mock_command()
        return (
            "Real motion is DISABLED in this BODYBOOT milestone - nothing was sent to the robot. "
            f"Would-be vendor call: {mock.get('vendor_symbol')}({mock.get('vendor_kwargs')})"
        )
